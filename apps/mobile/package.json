  "scripts": {
    "dev": "expo start",
    "dev:c": "expo start --clear",
    "pre": "npx expo prebuild",
    "pre:c": "npx expo prebuild --clean",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "doc": "expo-doctor",
    "doc:deps": "npx expo install --check",
    "web": "expo start --web",
    "lint": "expo lint",
    "reset-project": "node ./scripts/reset-project.js",
    "export": "npx expo export --platform ios --platform android",
    "build:android": "eas build --platform android --profile production --local",
    "patch": "npm version patch --no-git-tag-version",
    "minor": "npm version minor --no-git-tag-version",
    "major": "npm version major --no-git-tag-version",
    "version:show": "node -p \"require('./package.json').version\""
  },
